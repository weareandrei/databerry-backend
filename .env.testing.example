# ============================================================
# Test-script secrets.
#
# Used by the manual scripts under backend/test/manual/. NOT
# loaded by the running NestJS app — that reads from .env.
#
# To use:
#   1. Copy this file to .env.testing  (in the same folder)
#   2. Fill in the real values
#   3. Run any test/manual/ script — they auto-load this file.
#
# DO NOT commit .env.testing — it's gitignored. This template
# stays committed so onboarding stays self-explanatory.
#
# Only secrets live here. Non-sensitive constants (product IDs,
# tuning values, customer plans, etc.) stay hardcoded in the
# scripts themselves so they're version-controlled with the code.
# ============================================================

# ── Stripe ─────────────────────────────────────────────────
# Must be a test-mode key (sk_test_...). Scripts under
# test/manual/ refuse to run with a live key as a safety belt.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Connected account to seed data into. Find on the Stripe
# Dashboard → Connect → Accounts.
STRIPE_CONNECTED_ACCOUNT=acct_REPLACE_ME
