PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000

# Master key for application-layer encryption of credentials
# (OAuth tokens + API keys) before they're stored in Supabase.
# Generate with: openssl rand -hex 32
# MUST be the same value across every environment that touches the
# DB (local dev, Railway production, the migration script). Loss of
# this key = loss of every stored credential — there's no recovery
# path beyond users re-connecting each integration. See
# `src/common/crypto/encryption.ts` for the design rationale.
ENCRYPTION_KEY=

CALENDLY_CLIENT_ID=x
CALENDLY_CLIENT_SECRET=x

# Google oAuth
GA_CLIENT_ID=your_client_id_here
GA_CLIENT_SECRET=your_client_secret_here

ANTHROPIC_API_KEY=
