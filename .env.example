PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000

# Public base URL of THIS backend — used to build OAuth callback URLs
# for Calendly / Sentry / Stripe and the PostHog webhook target. MUST
# be set in production (otherwise callbacks fall back to localhost and
# every OAuth install will fail). Local dev can omit it; the fallback
# is `http://localhost:3001`.
#   Production: https://databerry.up.railway.app
WEBHOOK_BASE_URL=

# Master key for application-layer encryption of credentials
# (OAuth tokens + API keys) before they're stored in Supabase.
# Generate with: openssl rand -hex 32
# MUST be the same value across every environment that touches the
# DB (local dev, Railway production, the migration script). Loss of
# this key = loss of every stored credential — there's no recovery
# path beyond users re-connecting each integration. See
# `src/common/crypto/encryption.ts` for the design rationale.
ENCRYPTION_KEY=

CALENDLY_CLIENT_ID=x
CALENDLY_CLIENT_SECRET=x

# Google oAuth
GA_CLIENT_ID=your_client_id_here
GA_CLIENT_SECRET=your_client_secret_here

# Sentry OAuth (Public Integration)
# Created in Sentry → Settings → Developer Settings → Custom Integrations
# → Create New Integration → Public Integration. On the form:
#   Redirect URL : https://databerry.up.railway.app/sentry/oauth/callback
#                  (or http://localhost:3001/sentry/oauth/callback in dev)
#   Webhook URL  : same as Redirect URL — no webhook handler exists yet,
#                  Sentry just needs a 200-returning endpoint
#   Permissions  : Issue & Event = Read, Organization = Read
#                  (everything else: No Access)
#   Subscriptions: leave all unchecked (no webhook handler)
#   Verify install: UNCHECK. Our OAuth code path doesn't PUT
#                  status='installed' back to Sentry, so leaving this
#                  on traps every install in "Pending" state — at
#                  which point Sentry clips the access token's
#                  permissions and our org-slug lookup 401s/403s.
# After Save, Sentry shows three values you copy here:
#   - Client ID
#   - Client Secret
#   - Slug (lowercase-hyphenated form of the integration name, e.g.
#     `databerry`) — this is DIFFERENT from Client ID and is required
#     for the install URL to resolve.
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
SENTRY_INTEGRATION_SLUG=

ANTHROPIC_API_KEY=

# Resend transactional email — used by `POST /contact` (the public
# contact form on the landing page). RESEND_FROM is the sender
# identity; it MUST match a domain you've verified in the Resend
# dashboard (DKIM/SPF), otherwise sends will be rejected.
# Generate the API key at resend.com → API keys → "Send only".
RESEND_API_KEY=
RESEND_FROM=no-reply@heavenmade.org

# Stripe — Databerry charging users for subscriptions (separate
# from the user-owned Stripe Connect data integration). The
# STRIPE_SECRET_KEY is shared with the data-integration code path
# (the connect/webhook modules also use it as the platform key);
# STRIPE_BILLING_WEBHOOK_SECRET is specific to the new
# /billing/webhook endpoint and comes from the "Add endpoint" step
# in Stripe Dashboard → Developers → Webhooks (a different endpoint
# from the existing /webhooks/stripe endpoint, with its own signing
# secret). Events to subscribe: customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
